# Copy this file to .env and fill in your keys. Do not commit .env to git.
# Get Google key: https://aistudio.google.com/ (Gemini API)
# Get OpenRouter key (optional backup): https://openrouter.ai/keys

GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional: use OpenRouter as primary instead of Google
# LLM_PRIMARY=openrouter

# Optional: override model IDs (defaults: Gemini 3 Flash Preview)
# LLM_MODEL_GOOGLE=gemini-3-flash-preview
# LLM_MODEL_OPENROUTER=google/gemini-3-flash-preview

# Frontend only: backend URL when running Streamlit
# BACKEND_URL=http://localhost:8000
